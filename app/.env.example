# Copy to app/.env for local runs (scripts/dev.mjs reads it; shell variables win). On Netlify, set these in
# Site configuration > Environment variables. Never commit a real value.

# Required: Helius mainnet key, used server-side only for RPC (getProgramAccounts + memcmp) and DAS (coin metadata).
HELIUS_API_KEY=

# Optional: any mainnet RPC URL that allows getProgramAccounts with memcmp filters; overrides HELIUS_API_KEY for RPC.
PAYBLAME_RPC_URL=

# Optional, recommended: GitHub token with no scopes. Without it GitHub REST allows 60 requests/h per IP
# (shared on Netlify); logins then resolve through github.com/<login>.png redirects and ids print as github:#<id>.
GITHUB_TOKEN=

# Set this in production: HMAC secret for the masked ledger's row ids (row:<8 hex>). Any long random string, e.g.
# `openssl rand -hex 32`. Unset = a random secret is generated once and kept in Netlify Blobs (payblame/mask/secret).
LEDGER_MASK_SECRET=

# Optional: the project's own mint. Empty = pre-launch (/api/health says tokenMint: null, the site hides the CA).
# Read by /api/health at runtime and inlined into the site at build time, so redeploy after setting it.
TOKEN_MINT=

# Optional: reported by /api/health as keys.birdeye (name only); no endpoint calls Birdeye today.
BIRDEYE_API_KEY=

# Local only: where lib/store.mjs keeps its "Blobs" as JSON files. scripts/dev.mjs defaults it to app/.data;
# leave it unset on Netlify so the functions use Netlify Blobs.
# PAYBLAME_STORE_DIR=
