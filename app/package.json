{
  "name": "payblame-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The payblame site and its Netlify backend (https://payblame.netlify.app). The functions run the payblame library at the repo root.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs --port 8888",
    "watch": "node scripts/dev.mjs --port 8888 --watch",
    "test": "node --test \"test/*.test.mjs\"",
    "smoke": "node test/smoke.mjs",
    "record": "node test/record.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "three": "0.186.1"
  }
}
